# ==============================================================================
# Chitthi (चिठ्ठी) - Environment Configuration Template
# ==============================================================================
# Copy this file to .env before running docker compose up:
#   cp .env.example .env
# ==============================================================================

# Sarvam AI Subscription Key (Required for OCR, Translation, and Bulbul TTS)
SARVAM_API_KEY=your_sarvam_api_key_here

# Application Port
APP_PORT=8080

# PostgreSQL Configuration
POSTGRES_USER=chitthi
POSTGRES_PASSWORD=chitthi
POSTGRES_DB=chitthi
POSTGRES_PORT=5433

# RabbitMQ Configuration
RABBITMQ_USER=chitthi
RABBITMQ_PASSWORD=chitthi
RABBITMQ_PORT=5673
RABBITMQ_MGMT_PORT=15673

# MinIO / S3 Configuration
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101
S3_BUCKET=chitthi-documents
